{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BoldFaceType/mm/MM_MANIFEST.schema.json",
  "title": "MM Manifest Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "generated_at",
    "source",
    "scope",
    "files",
    "assessment"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "description": "Date string, typically YYYY-MM-DD"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "branch", "base_branch"],
      "properties": {
        "repo": {
          "type": "string",
          "format": "uri"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "total_files", "file_types"],
      "properties": {
        "description": {
          "type": "string"
        },
        "total_files": {
          "type": "integer",
          "minimum": 0
        },
        "file_types": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileEntry"
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_code_change", "classification", "notes"],
      "properties": {
        "is_code_change": {
          "type": "boolean"
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "size_bytes", "sha256", "summary"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "object",
          "additionalProperties": true
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
